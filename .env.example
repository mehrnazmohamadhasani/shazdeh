# ─── Database ────────────────────────────────────────────────────────────────
# Local: start Postgres with `docker compose up -d`, then:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"
# Production: your hosted Postgres URL
# DATABASE_URL="postgresql://user:password@host:5432/shazdeh"

# ─── Auth ────────────────────────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 48
# REQUIRED in production — without it admin sign-in is disabled
# (the dev fallback secret is public and would let anyone forge a session).
AUTH_SECRET="change-me-to-a-long-random-string-of-32-or-more-characters"

# Bootstrap admin (used by `npm run db:seed` only when the user doesn't
# exist yet — an existing admin's password is never reset). 12+ characters.
ADMIN_EMAIL="admin@shazdeh.ae"
ADMIN_PASSWORD=""

# db:seed and db:reset refuse to run unless DATABASE_URL is local.
# Set SEED_ALLOW_REMOTE=1 on the command line only, never in this file.

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical origin for SEO (canonicals, sitemap, Open Graph, JSON-LD).
# On Vercel it falls back to the production domain if unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Storage ─────────────────────────────────────────────────────────────────
# Supported: local | supabase | cloudinary
STORAGE_DRIVER="local"

# Supabase Storage (when STORAGE_DRIVER=supabase)
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_KEY="eyJhbGc..."
# SUPABASE_BUCKET="shazdeh-uploads"

# Cloudinary (when STORAGE_DRIVER=cloudinary)
# CLOUDINARY_CLOUD_NAME="your-cloud"
# CLOUDINARY_API_KEY="..."
# CLOUDINARY_API_SECRET="..."

# ─── Online ordering ─────────────────────────────────────────────────────────
# Online card payments (optional). Leave unset to offer pay-on-delivery only.
#   stripe → hosted Stripe Checkout (needs the two keys below)
#   mock   → local test gateway; refused in production
# PAYMENT_PROVIDER="stripe"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."   # endpoint: /api/payments/stripe/webhook

# Order notifications (all optional — the staff board always works)
# RESEND_API_KEY="re_..."            # email receipts/updates + kitchen inbox
# EMAIL_FROM="SHĀZDEH <orders@your-domain>"
# EMAIL_REPLY_TO="hello@your-domain"   # where customer replies go (optional)
# Web Push — order updates to customers' phones, new orders to staff devices.
# Generate once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY="B..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:orders@your-domain"
# ORDER_WEBHOOK_URL="https://hook.example.com/..."   # JSON per order event
# ORDER_WEBHOOK_SECRET="..."          # HMAC-SHA256 → X-Shazdeh-Signature

# Set to "true" once a lawyer has approved /legal/* (removes the draft notice)
# LEGAL_REVIEWED="true"

# ─── Ops: AI reading of invoices (/admin/ops) ───────────────────────────────
# Without a key, local development uses a fixed sample reading.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-5-mini"
