// Shazdeh — Premium Iranian-inspired kitchen brand (Dubai)
// Prisma schema configured for Postgres via prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  EDITOR
  // Kitchen / front-of-house: manages orders only, never the CMS.
  STAFF
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  passwordHash      String
  role              UserRole           @default(ADMIN)
  /// Bumped when the password changes: sessions signed with an older
  /// version stop working on every device.
  sessionVersion    Int                @default(0)
  pushSubscriptions PushSubscription[]
  opsDocuments      OpsDocument[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// ─── Menu ────────────────────────────────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  order     Int        @default(0)
  isActive  Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  nameFa         String?
  description    String?
  price          Float
  imageUrl       String?
  categoryId     String
  // Restrict: deleting a category must never take its dishes with it.
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ingredients    String?
  allergens      String?
  isVegetarian   Boolean         @default(false)
  isAvailable    Boolean         @default(true)
  // false = hidden from the menu and ordering entirely ("disabled").
  // isAvailable=false keeps it visible but marked sold out.
  isActive       Boolean         @default(true)
  order          Int             @default(0)
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  recipe         Recipe?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([categoryId])
}

// ─── Online ordering: customisation ────────────────────────────────────────
// Per-dish option groups, e.g. "Extras" (min 0, max 3) or "Rice" (min 1,
// max 1). Prices are deltas in AED added to the dish price.

model ModifierGroup {
  id        String           @id @default(cuid())
  itemId    String
  item      MenuItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name      String
  minSelect Int              @default(0)
  maxSelect Int              @default(1)
  order     Int              @default(0)
  options   ModifierOption[]

  @@index([itemId])
}

model ModifierOption {
  id          String        @id @default(cuid())
  groupId     String
  group       ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  price       Float         @default(0)
  isAvailable Boolean       @default(true)
  order       Int           @default(0)

  @@index([groupId])
}

// ─── Content ────────────────────────────────────────────────────────────────

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  width     Int?
  height    Int?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String // instagram | tiktok | whatsapp | talabat | deliveroo | careem | noon
  label     String
  url       String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestaurantSettings {
  id           String   @id @default("default")
  brandName    String   @default("Shazdeh")
  description  String?
  email        String?
  phone        String?
  whatsapp     String?
  address      String?
  openingHours String? // JSON string of weekly hours
  logoUrl      String?
  metaTitle    String?
  metaDesc     String?
  ogImageUrl   String?
  updatedAt    DateTime @updatedAt
}

// ─── Online ordering ────────────────────────────────────────────────────────
// All money on orders is stored in integer minor units (fils, 1 AED = 100
// fils) so totals never drift through floating-point rounding. Menu and
// zone prices stay in AED (Float) because that is what staff type in.

enum DeliveryModel {
  OWN_FLEET
  THIRD_PARTY
  HYBRID
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD_ON_DELIVERY
  ONLINE
}

enum OrderStatus {
  PENDING_PAYMENT // online payment started, not yet confirmed — hidden from the kitchen
  RECEIVED
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING // waiting for the gateway
  PAY_ON_DELIVERY // cash / card machine at the door
  PAID
  FAILED
  REFUNDED
  VOIDED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_DELIVERY
}

/// Single-row store (id = "default") for everything the kitchen tunes.
model OrderingSettings {
  id                 String          @id @default("default")
  // Master switch — doubles as "busy mode" when the kitchen is slammed.
  acceptingOrders    Boolean         @default(false)
  pausedMessage      String?
  // JSON object day → "12:00 — 23:00"; null falls back to opening hours.
  deliveryHours      String?
  kitchenLat         Float?
  kitchenLng         Float?
  vatRate            Float           @default(5)
  // UAE consumer prices must be shown VAT-inclusive; keep true unless
  // your accountant says otherwise.
  pricesIncludeVat   Boolean         @default(true)
  serviceFee         Float           @default(0)
  paymentMethods     PaymentMethod[] @default([CASH_ON_DELIVERY, CARD_ON_DELIVERY])
  deliveryModel      DeliveryModel   @default(OWN_FLEET)
  autoAccept         Boolean         @default(false)
  notifyEmail        String?
  // Legal identity — printed on receipts (simplified tax invoice) and in
  // the site's legal disclosure (Consumer Protection Law Art. 25).
  legalName          String?
  tradeLicenseNo     String?
  licensingAuthority String?
  trn                String?
  updatedAt          DateTime        @updatedAt
}

model DeliveryZone {
  id               String         @id @default(cuid())
  name             String
  fee              Float          @default(0)
  minOrder         Float          @default(0)
  freeDeliveryOver Float?
  etaMin           Int            @default(35)
  etaMax           Int            @default(50)
  // Optional straight-line limit from the kitchen, enforced when the
  // customer shares their location and kitchen coordinates are set.
  radiusKm         Float?
  isActive         Boolean        @default(true)
  order            Int            @default(0)
  areas            DeliveryArea[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

/// A named community ("Dubai Marina", "JLT") — how people in Dubai
/// describe where they live. Each belongs to exactly one zone.
model DeliveryArea {
  id     String       @id @default(cuid())
  zoneId String
  zone   DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name   String       @unique
  lat    Float?
  lng    Float?

  @@index([zoneId])
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique // stored upper-case
  description   String?
  type          CouponType
  value         Float      @default(0) // percent (0-100) or AED
  minSubtotal   Float      @default(0)
  maxDiscount   Float?
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  perPhoneLimit Int?
  usedCount     Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

/// Guest customers, keyed by mobile number. No passwords — checkout
/// never requires an account.
model Customer {
  id             String   @id @default(cuid())
  phone          String   @unique // E.164, e.g. +971501234567
  name           String
  email          String?
  marketingOptIn Boolean  @default(false)
  orders         Order[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id             String        @id @default(cuid())
  number         String        @unique // shown to humans, e.g. SZ-482913
  trackingToken  String        @unique // unguessable, for the tracking link
  idempotencyKey String        @unique
  status         OrderStatus
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  customerEmail String?

  // Address snapshot — never re-read from anywhere after placement.
  zoneId       String?
  zoneName     String
  areaName     String
  addressType  String // apartment | villa | office
  building     String
  street       String?
  unit         String?
  floor        String?
  instructions String?
  lat          Float?
  lng          Float?

  notes   String?
  cutlery Boolean @default(false)

  currency        String  @default("AED")
  subtotalFils    Int
  deliveryFeeFils Int
  serviceFeeFils  Int     @default(0)
  discountFils    Int     @default(0)
  vatFils         Int     @default(0) // VAT contained in (or added to) the total
  totalFils       Int
  couponId        String?
  couponCode      String?

  etaMin          Int
  etaMax          Int
  rejectionReason String?

  deliveryProvider String  @default("own_fleet")
  deliveryRef      String?
  trackingUrl      String?
  driverName       String?
  driverPhone      String?

  placedAt     DateTime  @default(now())
  confirmedAt  DateTime?
  preparingAt  DateTime?
  readyAt      DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  // Staff acknowledged the order — the admin alarm rings until this is
  // set (accepting does it; auto-accepted orders need a "Got it").
  seenAt       DateTime?
  // Kitchen + delivery tickets printed. Claimed atomically so only one
  // auto-printing device prints each order.
  printedAt    DateTime?

  items             OrderItem[]
  events            OrderEvent[]
  payments          Payment[]
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, placedAt])
  @@index([customerPhone])
  @@index([placedAt])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String?
  menuItem      MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name          String
  portion       String?
  unitPriceFils Int // dish + selected options
  quantity      Int
  lineTotalFils Int
  notes         String?
  /// [{ group, name, priceFils }]
  modifiers     Json      @default("[]")

  @@index([orderId])
}

/// Append-only audit trail: every status change, payment update and
/// staff note, with who did it.
model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // status | payment | note | dispatch
  status    OrderStatus?
  message   String?
  actor     String // staff email, "customer", "system" or a provider id
  createdAt DateTime     @default(now())

  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String // cash | stripe | mock | …
  providerRef   String?
  method        PaymentMethod
  amountFils    Int
  currency      String        @default("AED")
  status        PaymentStatus
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([provider, providerRef])
  @@index([orderId])
}

/// Processed gateway webhook ids — makes webhook handling idempotent.
model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventId   String
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}

/// Outbox / log of every customer or restaurant notification attempt.
model Notification {
  id        String   @id @default(cuid())
  orderId   String?
  event     String
  channel   String // email | push | webhook | log
  recipient String?
  status    String // sent | failed | skipped
  error     String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

/// Web Push endpoints. A customer subscribes for one order (orderId);
/// staff subscribe for new-order alerts (userId).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([userId])
}

// ─── Ops: purchasing and stock ──────────────────────────────────────────────
// A supplier invoice is photographed, read by AI into a canonical shape
// (OpsDocument.extraction), reviewed by a person, then saved as a
// PurchaseInvoice whose food/packaging lines add StockMovements. Stock on
// hand is always the sum of movements — never a stored number. Money is
// integer fils like orders.

enum OpsDocumentStatus {
  PROCESSING // AI is reading it
  NEEDS_REVIEW // read; waiting for a person to confirm
  SAVED // turned into a purchase invoice
  FAILED // AI could not read it (see error)
  DISCARDED
}

/// What a purchase line is. Only FOOD and PACKAGING feed food cost;
/// SUPPLIES (gas, cleaning, disposables) are kept in stock but are not food cost.
enum SpendCategory {
  FOOD
  PACKAGING
  SUPPLIES
  SMALLWARES
  DELIVERY
  OTHER
}

/// Stock is counted in grams, millilitres or pieces.
enum StockUnit {
  G
  ML
  PCS
}

enum StockMovementType {
  /// What was already in the kitchen when SHĀZDEH started using the system.
  OPENING
  PURCHASE
  CONSUMPTION
  WASTE
  STAFF_MEAL
  ADJUSTMENT
  COUNT
}

/// An uploaded file, kept immutably (private — served only to admins).
model OpsDocument {
  id             String            @id @default(cuid())
  /// supplier_invoice (purchases, statements, platform receipts) | recipe
  kind           String            @default("supplier_invoice")
  status         OpsDocumentStatus @default(PROCESSING)
  sha256         String            @unique // duplicate uploads are caught here
  mimeType       String
  sizeBytes      Int
  data           Bytes
  originalName   String?
  /// Canonical AI output (src/lib/ops/extraction.ts) plus matches to
  /// existing suppliers/ingredients.
  extraction     Json?
  aiModel        String?
  aiInputTokens  Int?
  aiOutputTokens Int?
  error          String?
  uploadedById   String?
  uploadedBy     User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  invoice        PurchaseInvoice?  @relation("InvoiceDocument")
  voidedInvoices PurchaseInvoice[] @relation("VoidedInvoiceDocument")
  recipeVersions RecipeVersion[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([kind, status])
}

model Supplier {
  id               String            @id @default(cuid())
  name             String
  trn              String?
  phone            String?
  notes            String?
  /// Days the supplier delivers: 0 = Sunday … 6 = Saturday.
  deliveryDays     Int[]             @default([])
  /// Days from order to delivery.
  leadTimeDays     Int?
  /// Credit terms: days after the invoice date that payment is due.
  paymentTermsDays Int?
  invoices         PurchaseInvoice[]
  items            SupplierItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([name])
  @@index([trn])
}

model Ingredient {
  id            String            @id @default(cuid())
  name          String            @unique
  nameFa        String?
  unit          StockUnit
  category      SpendCategory     @default(FOOD)
  supplierItems SupplierItem[]
  purchaseLines PurchaseLine[]
  movements     StockMovement[]
  recipeLines   RecipeLine[]
  recipeAliases RecipeNameAlias[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

/// Learned from confirmations: how a supplier prints an item, and how
/// much stock one of its units is ("Fanoos Sella 4x10kg" → rice, 40000 g).
model SupplierItem {
  id             String     @id @default(cuid())
  supplierId     String
  supplier       Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  rawName        String // normalised: lower-case, single spaces
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  baseQtyPerUnit Float
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([supplierId, rawName])
}

model PurchaseInvoice {
  id               String         @id @default(cuid())
  documentId       String?        @unique
  document         OpsDocument?   @relation("InvoiceDocument", fields: [documentId], references: [id], onDelete: SetNull)
  supplierId       String
  supplier         Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoiceNo        String?
  invoiceDate      DateTime
  paymentMode      String? // cash | card | credit | transfer
  pricesIncludeVat Boolean        @default(false)
  subtotalFils     Int?
  discountFils     Int            @default(0)
  vatFils          Int?
  totalFils        Int
  /// Handwritten hints and other notes read from the paper.
  notes            String?
  /// Credit invoices: when payment is due; null for cash/card.
  dueDate          DateTime?
  paidAt           DateTime?
  /// Who paid: "Owner", a staff name, "Company card"…
  paidBy           String?
  paymentNote      String?
  /// Undone: stock was reversed and the document went back to review.
  voidedAt         DateTime?
  voidReason       String?
  voidedDocumentId String?
  voidedDocument   OpsDocument?   @relation("VoidedInvoiceDocument", fields: [voidedDocumentId], references: [id], onDelete: SetNull)
  createdById      String?
  lines            PurchaseLine[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Not unique in the database: an undone invoice keeps its number and
  // may be saved again. Duplicates among live invoices are checked in code.
  @@index([supplierId, invoiceNo])
  @@index([invoiceDate])
  @@index([paymentMode, paidAt])
}

model PurchaseLine {
  id            String          @id @default(cuid())
  invoiceId     String
  invoice       PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  rawName       String
  itemCode      String?
  quantity      Float
  unit          String? // as printed: Pcs, kg, CTN…
  unitPriceFils Int?
  discountFils  Int             @default(0)
  vatFils       Int?
  lineTotalFils Int
  /// Cost of this line without VAT, after its share of any invoice
  /// discount — what food cost uses (SHĀZDEH reclaims input VAT).
  netFils       Int?
  category      SpendCategory
  ingredientId  String?
  ingredient    Ingredient?     @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  /// Stock added, in the ingredient's unit (quantity × pack size).
  baseQty       Float?
  movement      StockMovement?

  @@index([invoiceId])
  @@index([ingredientId])
}

/// Append-only stock ledger. quantity is signed, in the ingredient's unit.
model StockMovement {
  id             String            @id @default(cuid())
  ingredientId   String
  ingredient     Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  type           StockMovementType
  quantity       Float
  /// What this quantity cost, when known (purchases).
  costFils       Int?
  at             DateTime
  purchaseLineId String?           @unique
  purchaseLine   PurchaseLine?     @relation(fields: [purchaseLineId], references: [id], onDelete: Cascade)
  /// Set on the movement that cancels another (undoing an invoice).
  reversesId     String?           @unique
  reverses       StockMovement?    @relation("Reversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy     StockMovement?    @relation("Reversal")
  note           String?
  createdById    String?
  createdAt      DateTime          @default(now())

  @@index([ingredientId, at])
}

/// Shared rate-limit counters (sign-in, orders), so the limits hold
/// across every server instance. Expired rows are deleted lazily.
// ─── Ops: recipes ───────────────────────────────────────────────────────────
// A dish recipe is one portion of a menu item; a PREP is a sub-recipe
// (cooked rice, tahdig, khoresh base) that dishes use by weight. Recipes
// are versioned: drafts are edited, an approved version is the kitchen
// standard and is never changed. Costs are calculated on read from the
// latest purchase prices, never stored (see src/lib/ops/recipes.ts).

enum RecipeKind {
  DISH
  PREP
}

enum RecipeVersionStatus {
  DRAFT
  APPROVED
  /// Was approved; replaced by a newer approved version.
  RETIRED
}

model Recipe {
  id         String            @id @default(cuid())
  kind       RecipeKind
  name       String            @unique
  nameFa     String?
  /// DISH only: the menu item this is one portion of.
  menuItemId String?           @unique
  menuItem   MenuItem?         @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  versions   RecipeVersion[]
  usedIn     RecipeLine[]      @relation("SubRecipe")
  aliases    RecipeNameAlias[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model RecipeVersion {
  id               String              @id @default(cuid())
  recipeId         String
  recipe           Recipe              @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  number           Int
  status           RecipeVersionStatus @default(DRAFT)
  /// DISH: 1 PCS (one portion). PREP: what one batch makes, e.g. 5000 G.
  yieldQuantity    Float
  yieldUnit        StockUnit
  note             String?
  /// Steps, timings and quality notes, as the kitchen sheet says them.
  method           String?
  /// The photo this version was read from, if any.
  sourceDocumentId String?
  sourceDocument   OpsDocument?        @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdById      String?
  approvedById     String?
  approvedAt       DateTime?
  lines            RecipeLine[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([recipeId, number])
  @@index([recipeId, status])
  @@index([sourceDocumentId])
}

/// Exactly one of ingredientId / subRecipeId is set (CHECK in the migration).
model RecipeLine {
  id           String        @id @default(cuid())
  versionId    String
  version      RecipeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  order        Int           @default(0)
  ingredientId String?
  ingredient   Ingredient?   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  subRecipeId  String?
  subRecipe    Recipe?       @relation("SubRecipe", fields: [subRecipeId], references: [id], onDelete: Restrict)
  /// Amount used, in the ingredient's unit or the sub-recipe's yield unit.
  quantity     Float
  /// Trim / peel loss in percent: amount bought = quantity / (1 − wastePct/100).
  wastePct     Float         @default(0)
  note         String?

  @@index([versionId])
  @@index([ingredientId])
  @@index([subRecipeId])
}

/// What a name on a recipe sheet turned out to be, learned when someone
/// confirms a photo reading ("Parboiled rice" → the prep "Cooked rice").
/// Exactly one of ingredientId / recipeId is set.
model RecipeNameAlias {
  id           String      @id @default(cuid())
  rawName      String      @unique // normalised: lower-case, single spaces
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  recipeId     String?
  recipe       Recipe?     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Who changed what, before/after, and how (photo, voice, chat, manual).
model AuditLog {
  id        String   @id @default(cuid())
  actor     String // user email or "system"
  action    String // e.g. purchase_invoice.create
  entity    String
  entityId  String
  via       String   @default("manual")
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
