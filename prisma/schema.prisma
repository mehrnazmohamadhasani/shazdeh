// Shazdeh — Premium Iranian-inspired kitchen brand (Dubai)
// Prisma schema configured for Postgres via prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  EDITOR
  // Kitchen / front-of-house: manages orders only, never the CMS.
  STAFF
  // The person who buys and counts: invoices, stock and suppliers only.
  PURCHASER
}

model User {
  id                String                  @id @default(cuid())
  email             String                  @unique
  name              String?
  passwordHash      String
  role              UserRole                @default(ADMIN)
  /// Bumped when the password changes: sessions signed with an older
  /// version stop working on every device.
  sessionVersion    Int                     @default(0)
  pushSubscriptions PushSubscription[]
  opsDocuments      OpsDocument[]
  assistantActions  AssistantAction[]
  assistantChats    AssistantConversation[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

// ─── Menu ────────────────────────────────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  order     Int        @default(0)
  isActive  Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id             String              @id @default(cuid())
  slug           String              @unique
  name           String
  nameFa         String?
  description    String?
  price          Float
  imageUrl       String?
  categoryId     String
  // Restrict: deleting a category must never take its dishes with it.
  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ingredients    String?
  allergens      String?
  isVegetarian   Boolean             @default(false)
  isAvailable    Boolean             @default(true)
  // false = hidden from the menu and ordering entirely ("disabled").
  // isAvailable=false keeps it visible but marked sold out.
  isActive       Boolean             @default(true)
  order          Int                 @default(0)
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  platformItems  PlatformOrderItem[]
  aliases        MenuItemAlias[]
  freeFoodItems  FreeFoodItem[]
  stockUses      StockMovement[]
  recipe         Recipe?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([categoryId])
}

// ─── Online ordering: customisation ────────────────────────────────────────
// Per-dish option groups, e.g. "Extras" (min 0, max 3) or "Rice" (min 1,
// max 1). Prices are deltas in AED added to the dish price.

model ModifierGroup {
  id        String           @id @default(cuid())
  itemId    String
  item      MenuItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name      String
  minSelect Int              @default(0)
  maxSelect Int              @default(1)
  order     Int              @default(0)
  options   ModifierOption[]

  @@index([itemId])
}

model ModifierOption {
  id          String        @id @default(cuid())
  groupId     String
  group       ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  price       Float         @default(0)
  isAvailable Boolean       @default(true)
  order       Int           @default(0)

  @@index([groupId])
}

// ─── Content ────────────────────────────────────────────────────────────────

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  width     Int?
  height    Int?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String // instagram | tiktok | whatsapp | talabat | deliveroo | careem | noon
  label     String
  url       String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestaurantSettings {
  id           String   @id @default("default")
  brandName    String   @default("Shazdeh")
  description  String?
  email        String?
  phone        String?
  whatsapp     String?
  address      String?
  openingHours String? // JSON string of weekly hours
  logoUrl      String?
  metaTitle    String?
  metaDesc     String?
  ogImageUrl   String?
  updatedAt    DateTime @updatedAt
}

// ─── Online ordering ────────────────────────────────────────────────────────
// All money on orders is stored in integer minor units (fils, 1 AED = 100
// fils) so totals never drift through floating-point rounding. Menu and
// zone prices stay in AED (Float) because that is what staff type in.

enum DeliveryModel {
  OWN_FLEET
  THIRD_PARTY
  HYBRID
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD_ON_DELIVERY
  ONLINE
}

/// Where a Direct-channel order came from. Website orders are placed by the
/// customer (a link with ?src=whatsapp marks them WHATSAPP); staff enter
/// WhatsApp messages and phone calls in the admin.
enum OrderSource {
  WEBSITE
  WHATSAPP
  PHONE
}

enum OrderStatus {
  PENDING_PAYMENT // online payment started, not yet confirmed — hidden from the kitchen
  RECEIVED
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING // waiting for the gateway
  PAY_ON_DELIVERY // cash / card machine at the door
  PAID
  FAILED
  REFUNDED
  VOIDED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_DELIVERY
}

/// Single-row store (id = "default") for everything the kitchen tunes.
model OrderingSettings {
  id                 String          @id @default("default")
  // Master switch — doubles as "busy mode" when the kitchen is slammed.
  acceptingOrders    Boolean         @default(false)
  pausedMessage      String?
  // JSON object day → "12:00 — 23:00"; null falls back to opening hours.
  deliveryHours      String?
  kitchenLat         Float?
  kitchenLng         Float?
  vatRate            Float           @default(5)
  // UAE consumer prices must be shown VAT-inclusive; keep true unless
  // your accountant says otherwise.
  pricesIncludeVat   Boolean         @default(true)
  serviceFee         Float           @default(0)
  paymentMethods     PaymentMethod[] @default([CASH_ON_DELIVERY, CARD_ON_DELIVERY])
  deliveryModel      DeliveryModel   @default(OWN_FLEET)
  autoAccept         Boolean         @default(false)
  notifyEmail        String?
  // Legal identity — printed on receipts (simplified tax invoice) and in
  // the site's legal disclosure (Consumer Protection Law Art. 25).
  legalName          String?
  tradeLicenseNo     String?
  licensingAuthority String?
  trn                String?
  updatedAt          DateTime        @updatedAt
}

model DeliveryZone {
  id               String         @id @default(cuid())
  name             String
  fee              Float          @default(0)
  minOrder         Float          @default(0)
  freeDeliveryOver Float?
  etaMin           Int            @default(35)
  etaMax           Int            @default(50)
  // Optional straight-line limit from the kitchen, enforced when the
  // customer shares their location and kitchen coordinates are set.
  radiusKm         Float?
  isActive         Boolean        @default(true)
  order            Int            @default(0)
  areas            DeliveryArea[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

/// A named community ("Dubai Marina", "JLT") — how people in Dubai
/// describe where they live. Each belongs to exactly one zone.
model DeliveryArea {
  id     String       @id @default(cuid())
  zoneId String
  zone   DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name   String       @unique
  lat    Float?
  lng    Float?

  @@index([zoneId])
}

model Coupon {
  id             String      @id @default(cuid())
  code           String      @unique // stored upper-case
  description    String?
  type           CouponType
  value          Float       @default(0) // percent (0-100) or AED
  minSubtotal    Float       @default(0)
  maxDiscount    Float?
  startsAt       DateTime?
  endsAt         DateTime?
  usageLimit     Int?
  perPhoneLimit  Int?
  usedCount      Int         @default(0)
  isActive       Boolean     @default(true)
  /// QR gift: customers claim it on /gift/CODE with mobile + email, and
  /// it is applied by itself when they order with that mobile.
  isGift         Boolean     @default(false)
  /// Only for a mobile with no earlier (non-cancelled) order.
  firstOrderOnly Boolean     @default(false)
  /// Scans of the printed QR (/g/CODE), roughly one per device.
  scanCount      Int         @default(0)
  claims         GiftClaim[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

/// A customer who scanned a gift QR and left their mobile and email.
/// The gift works for that mobile right away and is used by the order in
/// orderId (cleared again if that order is cancelled or rejected).
/// activatedAt: when they first opened the link in the gift email.
model GiftClaim {
  id             String    @id @default(cuid())
  couponId       String
  coupon         Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  name           String?
  phone          String // E.164
  email          String // lower-case
  marketingOptIn Boolean   @default(false)
  token          String    @unique // for the activation link
  emailStatus    String    @default("pending") // sent | failed | skipped | pending
  activatedAt    DateTime?
  orderId        String?   @unique
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([couponId, phone])
  @@unique([couponId, email])
  @@index([phone])
}

/// Guest customers, keyed by mobile number. No passwords — checkout
/// never requires an account.
model Customer {
  id             String   @id @default(cuid())
  phone          String   @unique // E.164, e.g. +971501234567
  name           String
  email          String?
  marketingOptIn Boolean  @default(false)
  orders         Order[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id             String        @id @default(cuid())
  number         String        @unique // shown to humans, e.g. SZ-482913
  trackingToken  String        @unique // unguessable, for the tracking link
  idempotencyKey String        @unique
  status         OrderStatus
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus
  source         OrderSource   @default(WEBSITE)
  /// Staff member who entered it (WhatsApp / phone orders); null when the customer ordered.
  enteredById    String?

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  customerEmail String?

  // Address snapshot — never re-read from anywhere after placement.
  zoneId       String?
  zoneName     String
  areaName     String
  addressType  String // apartment | villa | office
  building     String
  street       String?
  unit         String?
  floor        String?
  instructions String?
  lat          Float?
  lng          Float?

  notes   String?
  cutlery Boolean @default(false)

  currency        String     @default("AED")
  subtotalFils    Int
  deliveryFeeFils Int
  serviceFeeFils  Int        @default(0)
  discountFils    Int        @default(0)
  vatFils         Int        @default(0) // VAT contained in (or added to) the total
  totalFils       Int
  couponId        String?
  couponCode      String?
  giftClaim       GiftClaim?

  etaMin          Int
  etaMax          Int
  rejectionReason String?

  deliveryProvider String  @default("own_fleet")
  deliveryRef      String?
  trackingUrl      String?
  driverName       String?
  driverPhone      String?

  placedAt     DateTime  @default(now())
  confirmedAt  DateTime?
  preparingAt  DateTime?
  readyAt      DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  // Staff acknowledged the order — the admin alarm rings until this is
  // set (accepting does it; auto-accepted orders need a "Got it").
  seenAt       DateTime?
  // Kitchen + delivery tickets printed. Claimed atomically so only one
  // auto-printing device prints each order.
  printedAt    DateTime?

  items             OrderItem[]
  stockUses         StockMovement[]
  events            OrderEvent[]
  payments          Payment[]
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, placedAt])
  @@index([customerPhone])
  @@index([placedAt])
  @@index([source, placedAt])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String?
  menuItem      MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name          String
  portion       String?
  unitPriceFils Int // dish + selected options
  quantity      Int
  lineTotalFils Int
  notes         String?
  /// [{ group, name, priceFils }]
  modifiers     Json      @default("[]")

  @@index([orderId])
}

/// Append-only audit trail: every status change, payment update and
/// staff note, with who did it.
model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // status | payment | note | dispatch
  status    OrderStatus?
  message   String?
  actor     String // staff email, "customer", "system" or a provider id
  createdAt DateTime     @default(now())

  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String // cash | stripe | mock | …
  providerRef   String?
  method        PaymentMethod
  amountFils    Int
  currency      String        @default("AED")
  status        PaymentStatus
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([provider, providerRef])
  @@index([orderId])
}

/// Processed gateway webhook ids — makes webhook handling idempotent.
model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventId   String
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}

/// Outbox / log of every customer or restaurant notification attempt.
model Notification {
  id        String   @id @default(cuid())
  orderId   String?
  event     String
  channel   String // email | push | webhook | log
  recipient String?
  status    String // sent | failed | skipped
  error     String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

/// Web Push endpoints. A customer subscribes for one order (orderId);
/// staff subscribe for new-order alerts (userId).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([userId])
}

// ─── Ops: purchasing and stock ──────────────────────────────────────────────
// A supplier invoice is photographed, read by AI into a canonical shape
// (OpsDocument.extraction), reviewed by a person, then saved as a
// PurchaseInvoice whose food/packaging lines add StockMovements. Stock on
// hand is always the sum of movements — never a stored number. Money is
// integer fils like orders.

enum OpsDocumentStatus {
  PROCESSING // AI is reading it
  NEEDS_REVIEW // read; waiting for a person to confirm
  SAVED // turned into a purchase invoice
  FAILED // AI could not read it (see error)
  DISCARDED
}

/// What a purchase line is. Only FOOD and PACKAGING feed food cost;
/// SUPPLIES (gas, cleaning, disposables) are kept in stock but are not food cost.
enum SpendCategory {
  FOOD
  PACKAGING
  SUPPLIES
  SMALLWARES
  DELIVERY
  OTHER
}

/// Stock is counted in grams, millilitres or pieces.
enum StockUnit {
  G
  ML
  PCS
}

enum StockMovementType {
  /// What was already in the kitchen when SHĀZDEH started using the system.
  OPENING
  PURCHASE
  CONSUMPTION
  WASTE
  STAFF_MEAL
  /// Food given away: gifts, tastings, compensation to a customer.
  GIFT
  ADJUSTMENT
  COUNT
}

/// An uploaded file, kept immutably (private — served only to admins).
model OpsDocument {
  id               String            @id @default(cuid())
  /// supplier_invoice (purchases, statements, platform receipts) | recipe | payment_receipt
  kind             String            @default("supplier_invoice")
  status           OpsDocumentStatus @default(PROCESSING)
  sha256           String            @unique // duplicate uploads are caught here
  mimeType         String
  sizeBytes        Int
  data             Bytes
  originalName     String?
  /// Canonical AI output (src/lib/ops/extraction.ts) plus matches to
  /// existing suppliers/ingredients.
  extraction       Json?
  aiModel          String?
  aiInputTokens    Int?
  aiOutputTokens   Int?
  error            String?
  uploadedById     String?
  uploadedBy       User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  invoice          PurchaseInvoice?  @relation("InvoiceDocument")
  voidedInvoices   PurchaseInvoice[] @relation("VoidedInvoiceDocument")
  /// Payment receipts: the invoices this proof of payment is for.
  paidInvoices     PurchaseInvoice[] @relation("PaymentReceipt")
  recipeVersions   RecipeVersion[]
  platformOrder    PlatformOrder?
  /// Voice notes: the assistant changes this note asked for.
  assistantActions AssistantAction[]
  /// Saved without a person checking it: every check passed and the
  /// reading was confident (Ops settings). Shown so someone can look.
  autoSaved        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([kind, status])
}

model Supplier {
  id               String            @id @default(cuid())
  name             String
  trn              String?
  phone            String?
  notes            String?
  /// Days the supplier delivers: 0 = Sunday … 6 = Saturday.
  deliveryDays     Int[]             @default([])
  /// Days from order to delivery.
  leadTimeDays     Int?
  /// Credit terms: days after the invoice date that payment is due.
  paymentTermsDays Int?
  invoices         PurchaseInvoice[]
  items            SupplierItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([name])
  @@index([trn])
}

model Ingredient {
  id            String            @id @default(cuid())
  name          String            @unique
  nameFa        String?
  unit          StockUnit
  category      SpendCategory     @default(FOOD)
  /// Warn on Today when stock on hand is at or below this (g / ml / pcs).
  /// Null: no warning set.
  lowStockAt    Float?
  supplierItems SupplierItem[]
  purchaseLines PurchaseLine[]
  movements     StockMovement[]
  recipeLines   RecipeLine[]
  recipeAliases RecipeNameAlias[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

/// Learned from confirmations: how a supplier prints an item, and how
/// much stock one of its units is ("Fanoos Sella 4x10kg" → rice, 40000 g).
model SupplierItem {
  id             String     @id @default(cuid())
  supplierId     String
  supplier       Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  rawName        String // normalised: lower-case, single spaces
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  baseQtyPerUnit Float
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([supplierId, rawName])
}

model PurchaseInvoice {
  id                 String         @id @default(cuid())
  documentId         String?        @unique
  document           OpsDocument?   @relation("InvoiceDocument", fields: [documentId], references: [id], onDelete: SetNull)
  supplierId         String
  supplier           Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoiceNo          String?
  invoiceDate        DateTime
  paymentMode        String? // cash | card | credit | transfer
  pricesIncludeVat   Boolean        @default(false)
  subtotalFils       Int?
  discountFils       Int            @default(0)
  vatFils            Int?
  totalFils          Int
  /// Handwritten hints and other notes read from the paper.
  notes              String?
  /// Credit invoices: when payment is due; null for cash/card.
  dueDate            DateTime?
  paidAt             DateTime?
  /// Who paid: "Owner", a staff name, "Company card"…
  paidBy             String?
  /// Paid with that person's own money: the business owes it back to
  /// them (Owner cash), unless they took the cash from the business first.
  paidPersonally     Boolean        @default(false)
  paymentNote        String?
  /// Proof of payment (card slip, bank transfer, card-to-card screenshot).
  /// One transfer may pay several invoices, so a receipt can be shared.
  paymentReceiptId   String?
  paymentReceipt     OpsDocument?   @relation("PaymentReceipt", fields: [paymentReceiptId], references: [id], onDelete: SetNull)
  /// card | bank | card_to_card
  paymentReceiptKind String?
  /// Undone: stock was reversed and the document went back to review.
  voidedAt           DateTime?
  voidReason         String?
  voidedDocumentId   String?
  voidedDocument     OpsDocument?   @relation("VoidedInvoiceDocument", fields: [voidedDocumentId], references: [id], onDelete: SetNull)
  createdById        String?
  lines              PurchaseLine[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Not unique in the database: an undone invoice keeps its number and
  // may be saved again. Duplicates among live invoices are checked in code.
  @@index([supplierId, invoiceNo])
  @@index([invoiceDate])
  @@index([paymentMode, paidAt])
}

model PurchaseLine {
  id            String          @id @default(cuid())
  invoiceId     String
  invoice       PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  rawName       String
  itemCode      String?
  quantity      Float
  unit          String? // as printed: Pcs, kg, CTN…
  unitPriceFils Int?
  discountFils  Int             @default(0)
  vatFils       Int?
  lineTotalFils Int
  /// Cost of this line without VAT, after its share of any invoice
  /// discount — what food cost uses (SHĀZDEH reclaims input VAT).
  netFils       Int?
  /// The same cost with its share of the invoice's VAT — what food cost
  /// uses when OpsSettings.foodCostIncludesVat is on.
  grossFils     Int?
  category      SpendCategory
  ingredientId  String?
  ingredient    Ingredient?     @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  /// Stock added, in the ingredient's unit (quantity × pack size).
  baseQty       Float?
  movement      StockMovement?

  @@index([invoiceId])
  @@index([ingredientId])
}

/// Append-only stock ledger. quantity is signed, in the ingredient's unit.
model StockMovement {
  id              String            @id @default(cuid())
  ingredientId    String
  ingredient      Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  type            StockMovementType
  quantity        Float
  /// What this quantity cost, when known (purchases).
  costFils        Int?
  at              DateTime
  purchaseLineId  String?           @unique
  purchaseLine    PurchaseLine?     @relation(fields: [purchaseLineId], references: [id], onDelete: Cascade)
  /// What a CONSUMPTION movement was for: the sale (website or platform
  /// order), the dish and the approved recipe version used.
  orderId         String?
  order           Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  platformOrderId String?
  platformOrder   PlatformOrder?    @relation(fields: [platformOrderId], references: [id], onDelete: SetNull)
  menuItemId      String?
  menuItem        MenuItem?         @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  recipeVersionId String?
  recipeVersion   RecipeVersion?    @relation(fields: [recipeVersionId], references: [id], onDelete: SetNull)
  /// Free food (staff meal, gift…) this movement is part of.
  freeFoodId      String?
  freeFood        FreeFood?         @relation(fields: [freeFoodId], references: [id], onDelete: SetNull)
  /// Set on the movement that cancels another (undoing an invoice).
  reversesId      String?           @unique
  reverses        StockMovement?    @relation("Reversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy      StockMovement?    @relation("Reversal")
  note            String?
  createdById     String?
  createdAt       DateTime          @default(now())

  @@index([ingredientId, at])
  @@index([orderId])
  @@index([platformOrderId])
  @@index([freeFoodId])
}

/// Shared rate-limit counters (sign-in, orders), so the limits hold
/// across every server instance. Expired rows are deleted lazily.
// ─── Ops: recipes ───────────────────────────────────────────────────────────
// A dish recipe is one portion of a menu item; a PREP is a sub-recipe
// (cooked rice, tahdig, khoresh base) that dishes use by weight. Recipes
// are versioned: drafts are edited, an approved version is the kitchen
// standard and is never changed. Costs are calculated on read from the
// latest purchase prices, never stored (see src/lib/ops/recipes.ts).

enum RecipeKind {
  DISH
  PREP
}

enum RecipeVersionStatus {
  DRAFT
  APPROVED
  /// Was approved; replaced by a newer approved version.
  RETIRED
}

model Recipe {
  id         String            @id @default(cuid())
  kind       RecipeKind
  name       String            @unique
  nameFa     String?
  /// DISH only: the menu item this is one portion of.
  menuItemId String?           @unique
  menuItem   MenuItem?         @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  versions   RecipeVersion[]
  usedIn     RecipeLine[]      @relation("SubRecipe")
  aliases    RecipeNameAlias[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model RecipeVersion {
  id               String              @id @default(cuid())
  recipeId         String
  recipe           Recipe              @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  number           Int
  status           RecipeVersionStatus @default(DRAFT)
  /// DISH: 1 PCS (one portion). PREP: what one batch makes, e.g. 5000 G.
  yieldQuantity    Float
  yieldUnit        StockUnit
  note             String?
  /// Steps, timings and quality notes, as the kitchen sheet says them.
  method           String?
  /// The photo this version was read from, if any.
  sourceDocumentId String?
  sourceDocument   OpsDocument?        @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdById      String?
  approvedById     String?
  approvedAt       DateTime?
  lines            RecipeLine[]
  stockUses        StockMovement[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([recipeId, number])
  @@index([recipeId, status])
  @@index([sourceDocumentId])
}

/// Exactly one of ingredientId / subRecipeId is set (CHECK in the migration).
model RecipeLine {
  id           String        @id @default(cuid())
  versionId    String
  version      RecipeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  order        Int           @default(0)
  ingredientId String?
  ingredient   Ingredient?   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  subRecipeId  String?
  subRecipe    Recipe?       @relation("SubRecipe", fields: [subRecipeId], references: [id], onDelete: Restrict)
  /// Amount used, in the ingredient's unit or the sub-recipe's yield unit.
  quantity     Float
  /// Trim / peel loss in percent: amount bought = quantity / (1 − wastePct/100).
  wastePct     Float         @default(0)
  note         String?

  @@index([versionId])
  @@index([ingredientId])
  @@index([subRecipeId])
}

/// What a name on a recipe sheet turned out to be, learned when someone
/// confirms a photo reading ("Parboiled rice" → the prep "Cooked rice").
/// Exactly one of ingredientId / recipeId is set.
model RecipeNameAlias {
  id           String      @id @default(cuid())
  rawName      String      @unique // normalised: lower-case, single spaces
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  recipeId     String?
  recipe       Recipe?     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// ─── Ops: settings, owner cash, AI usage ────────────────────────────────────

/// Single-row store (id = "default") for how the kitchen's numbers are worked out.
model OpsSettings {
  id                    String   @id @default("default")
  /// false: food cost without VAT (VAT reclaimed). true: with the VAT paid.
  foodCostIncludesVat   Boolean  @default(false)
  /// AI reading stops for the month once this is spent (US dollars).
  aiMonthlyCapUsd       Float    @default(30)
  /// "2026-10" once the 80 % warning has been sent for that month.
  aiWarnedMonth         String?
  /// Save a platform receipt without review when everything checks out.
  autoSavePlatform      Boolean  @default(true)
  /// Save a supplier invoice without review when the supplier and every
  /// stock line are already known and everything checks out.
  autoSaveInvoices      Boolean  @default(true)
  /// Lowest AI confidence (overall and per line) for saving without review.
  autoSaveMinConfidence Float    @default(0.9)
  updatedAt             DateTime @updatedAt
}

/// Cash someone took from the business account to pay for purchases. Set
/// against the cash/card invoices they present (PurchaseInvoice.paidBy).
model CashWithdrawal {
  id          String    @id @default(cuid())
  /// Who took it: "Owner", a staff name — matched to paidBy on invoices.
  person      String
  amountFils  Int
  at          DateTime
  note        String?
  createdById String?
  /// Removed by mistake-correction; kept for the audit trail.
  voidedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([person, at])
}

/// One AI call: what it cost, so a monthly cap can stop runaway spending.
model AiUsage {
  id           String   @id @default(cuid())
  /// invoice | recipe | platform | assistant | voice
  kind         String
  model        String
  inputTokens  Int
  outputTokens Int
  /// Estimated cost in millionths of a US dollar.
  costMicroUsd Int
  documentId   String?
  at           DateTime @default(now())

  @@index([at])
}

// ─── Sales channels and platform orders ─────────────────────────────────────
// Website orders stay in Order. Delivery-platform orders are read from the
// receipt photo into PlatformOrder. Channels are data, not code: a new
// platform is a Channel row plus (when known) a fee rule. Receipts carry
// no commission, so fees come only from dated fee rules or statements,
// never from a guess.

enum ChannelKind {
  DIRECT
  PLATFORM
}

/// Who pays for a discount printed on a receipt. UNKNOWN until the owner says.
enum FundedBy {
  UNKNOWN
  RESTAURANT
  PLATFORM
  SHARED
}

model Channel {
  id        String           @id @default(cuid())
  /// direct, talabat, careem, deliveroo, noon, keeta
  code      String           @unique
  name      String
  kind      ChannelKind
  isActive  Boolean          @default(true)
  order     Int              @default(0)
  feeRules  ChannelFeeRule[]
  orders    PlatformOrder[]
  aliases   MenuItemAlias[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

/// A platform's fees from a date (contract or statement). Never assumed.
model ChannelFeeRule {
  id            String    @id @default(cuid())
  channelId     String
  channel       Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  validFrom     DateTime  @db.Date
  /// Null: still valid.
  validTo       DateTime? @db.Date
  /// Percent of food sales.
  commissionPct Float?
  /// Percent of food sales charged for card payments.
  paymentFeePct Float?
  /// Per order, in fils.
  fixedFeeFils  Int?
  /// The platform adds 5 % VAT on its fees.
  vatOnFees     Boolean   @default(true)
  note          String?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([channelId, validFrom])
}

model PlatformOrder {
  id                String              @id @default(cuid())
  channelId         String
  channel           Channel             @relation(fields: [channelId], references: [id], onDelete: Restrict)
  /// The number printed with "#" or "Order No" (talabat #2309, Careem #17387).
  orderNo           String
  /// Any other ID on the receipt (talabat's long number, Careem's large code).
  altOrderId        String?
  /// Dubai calendar day the order was placed.
  businessDate      DateTime            @db.Date
  placedAt          DateTime
  /// delivery | pickup
  fulfilment        String?
  /// As printed: "PREPAID CREDIT_CARD", "POSTPAID"…
  payment           String?
  /// What SHĀZDEH sold: the food subtotal. Customer delivery/service fees
  /// go to the platform and are not SHĀZDEH's sales.
  foodSalesFils     Int
  /// printed | menu (Deliveroo prints no line prices)
  salesSource       String              @default("printed")
  subtotalFils      Int?
  deliveryFeeFils   Int?
  serviceFeeFils    Int?
  discountFils      Int                 @default(0)
  discountFundedBy  FundedBy            @default(UNKNOWN)
  totalFils         Int
  /// First name only; never a phone number (brief §13.10).
  customerFirstName String?
  note              String?
  documentId        String?             @unique
  document          OpsDocument?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  items             PlatformOrderItem[]
  stockUses         StockMovement[]
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([channelId, orderNo, businessDate])
  @@index([businessDate])
  @@index([channelId, altOrderId])
}

model PlatformOrderItem {
  id            String        @id @default(cuid())
  orderId       String
  order         PlatformOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// As printed: "MAKARONI Large Portion"
  rawName       String
  /// The heading above it on the receipt: "VEGETARIAN", "SIDES"
  category      String?
  menuItemId    String?
  menuItem      MenuItem?     @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  quantity      Int
  lineTotalFils Int?
  /// The line total was taken from the menu price (not printed).
  priceFromMenu Boolean       @default(false)

  @@index([orderId])
  @@index([menuItemId])
}

/// How a platform names a menu item, learned when someone confirms it.
model MenuItemAlias {
  id         String   @id @default(cuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Normalised: lower-case, single spaces, with the receipt heading if any.
  rawName    String
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([channelId, rawName])
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Who changed what, before/after, and how (photo, voice, chat, manual).
model AuditLog {
  id        String   @id @default(cuid())
  actor     String // user email or "system"
  action    String // e.g. purchase_invoice.create
  entity    String
  entityId  String
  via       String   @default("manual")
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ─── Ops: assistant ─────────────────────────────────────────────────────────
// The voice and chat assistant never writes on its own: each change it
// suggests is stored here as a proposal with its before/after preview,
// applied only when a person confirms, and can be undone.

enum AssistantActionStatus {
  PROPOSED
  APPLIED
  CANCELLED
  UNDONE
}

model AssistantAction {
  id               String                @id @default(cuid())
  userId           String?
  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// record_waste | record_staff_meal | adjust_stock | stock_count | change_recipe | fix_invoice_price
  tool             String
  /// chat | voice
  via              String
  status           AssistantActionStatus @default(PROPOSED)
  /// Needs a second confirmation (money, recipes, big differences).
  sensitive        Boolean               @default(false)
  /// The validated tool input, with names resolved to ids.
  input            Json
  /// What the person saw before confirming (before/after).
  preview          Json
  /// What applying made (movement ids, versions…), used to undo it.
  result           Json?
  /// The voice note this came from, if it was spoken.
  sourceDocumentId String?
  sourceDocument   OpsDocument?          @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  appliedAt        DateTime?
  undoneAt         DateTime?

  @@index([userId, createdAt])
  @@index([sourceDocumentId])
}

/// A chat with the assistant, kept so the person can reopen or delete it
/// (the screen lists their latest few). Deleting one never touches the
/// changes it made: those live on in AssistantAction and AuditLog.
model AssistantConversation {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The first thing said, shortened.
  title     String
  messages  AssistantMessage[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, updatedAt])
}

model AssistantMessage {
  id              String                @id @default(cuid())
  conversationId  String
  conversation    AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant
  role            String
  text            String
  /// The changes this answer suggested (AssistantAction ids), shown as cards.
  actionIds       String[]              @default([])
  /// The voice note this message was spoken as, if any.
  voiceDocumentId String?
  createdAt       DateTime              @default(now())

  @@index([conversationId, createdAt])
}

// ─── Ops: free food ─────────────────────────────────────────────────────────
// Dishes that leave the kitchen without a sale: staff meals, gifts (a
// photographer, workers next door), tastings, and food given to make up
// for a complaint. They take stock through the approved recipes like a
// sale, bring no revenue, and keep what they cost at the time.

enum FreeFoodKind {
  STAFF_MEAL
  GIFT
  TASTING
  COMPENSATION
}

model FreeFood {
  id               String          @id @default(cuid())
  kind             FreeFoodKind
  /// When the food was given (Dubai day at noon when only a day is known).
  at               DateTime
  /// Who got it ("Photographer", "Staff", a customer's name) — optional.
  recipient        String?
  reason           String?
  /// Food cost at the time from approved recipes; null when any dish had none (unknown, never guessed).
  costFils         Int?
  /// What the same dishes sell for on the menu (VAT included), at the time.
  menuValueFils    Int
  /// manual | chat | voice
  via              String          @default("manual")
  /// The voice note it came from, if spoken.
  sourceDocumentId String?
  createdById      String?
  createdAt        DateTime        @default(now())
  /// Undone: its stock was put back.
  voidedAt         DateTime?
  items            FreeFoodItem[]
  stockUses        StockMovement[]

  @@index([at])
  @@index([kind, at])
}

model FreeFoodItem {
  id            String    @id @default(cuid())
  freeFoodId    String
  freeFood      FreeFood  @relation(fields: [freeFoodId], references: [id], onDelete: Cascade)
  menuItemId    String?
  menuItem      MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name          String
  quantity      Int
  /// Cost of one portion at the time (approved recipe × latest prices); null when unknown.
  unitCostFils  Int?
  menuPriceFils Int

  @@index([freeFoodId])
}

/// An email campaign written in the admin panel and sent as a Resend
/// Broadcast (marketing quota, separate from order emails). Only to
/// customers who agreed to news and offers and haven't unsubscribed.
model Campaign {
  id             String    @id @default(cuid())
  subject        String
  previewText    String?
  heading        String
  body           String // plain text; blank lines start a new paragraph
  imageUrl       String?
  buttonLabel    String?
  buttonUrl      String?
  promoCode      String?
  audience       String    @default("marketing") // marketing | lapsed | gift_no_order
  status         String    @default("DRAFT") // DRAFT | SENDING | SENT | FAILED
  recipientCount Int?
  broadcastId    String? // Resend Broadcast id, for its stats
  error          String?
  createdBy      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Emails that unsubscribed from campaigns (copied from Resend before
/// every send). They never get a campaign again, whatever a later
/// checkbox says.
model MarketingUnsubscribe {
  email String   @id // lower-case
  at    DateTime @default(now())
}
